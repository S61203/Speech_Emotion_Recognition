def textEmotion():
    global tfidf_vectorizer, stop_words, rf_cls, recognizer, start
    text.delete('1.0', END)
    data = "unable to recognize"
    with sr.WavFile('audio/Audio'+str(start)+'.wav') as source:
        audio = recognizer.record(source)
    try:
        data = recognizer.recognize_google(audio)
    except Exception as ex:
        data = "unable to recognize"
    if data != 'unable to recognize':
        text.insert(END,"Extracted Text from Video = "+data+"\n\n")
        arr = data.split(" ")
        msg = ''
        for k in range(len(arr)):#remove stop words
            word = arr[k].strip()
            if len(word) > 2 and word not in stop_words:
                msg+=arr[k]+" "
        text_data = msg.strip()
        text_data = [text_data]
        text_data = tfidf_vectorizer.transform(text_data).toarray()#convert text to numeric vector
        predict = rf_cls.predict(text_data)[0]# predict sentiment from test comments
        print(predict)
        if predict == 0:
            text.insert(END,"Video Text Emotion = Happy\n\n")
        elif predict == 1:
            text.insert(END,"Video Text Emotion = Sad\n\n")
    else:
        text.insert(END,data+"\n")
    

